---
// src/pages/index.astro — Grupo Los Robles
// Rediseño "Anillos de Roble" — en construcción sección por sección (ver CLAUDE.md §16).
// Checkpoint actual: Header (chrome global) + Hero. El resto de secciones (Alcance,
// Divisiones/slider horizontal, Manifiesto, Contacto) se agregan una a una tras aprobación.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const _seo = {
  title: 'Grupo Los Robles — 20 años, cinco raíces sólidas',
  description:
    'Holding chileno con más de 20 años de trayectoria en Gastronomía, Vestuario, Agrícola, Soluciones Tecnológicas e Inmobiliaria.',
  ogImage: '/images/hero-bosque.jpg',
  googleFontsUrl:
    'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Manrope:wght@400;500;600&display=swap',
};

const _schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Grupo Los Robles',
  url: 'https://grupolosrobles.com',
  logo: 'https://grupolosrobles.com/images/logo-losRobles.webp',
  description:
    'Holding con más de 20 años de trayectoria en Gastronomía, Vestuario, Agrícola, Soluciones Tecnológicas e Inmobiliaria.',
};

const _hero = {
  eyebrow: '20 años de raíces',
  headline: 'De una idea a cinco raíces sólidas',
  subheadline:
    'Gastronomía, vestuario, agro, tecnología e inmobiliaria — construidos con la misma convicción que hace veinte años transformó una idea en una de las redes empresariales más sólidas de Chile.',
  ctaText: 'Explorar las divisiones',
  ctaHref: '#divisiones',
};
---

<Layout
  title={_seo.title}
  description={_seo.description}
  image={_seo.ogImage}
  googleFontsUrl={_seo.googleFontsUrl}
  schemaData={_schema}
>
  <Hero
    eyebrow={_hero.eyebrow}
    headline={_hero.headline}
    subheadline={_hero.subheadline}
    ctaText={_hero.ctaText}
    ctaHref={_hero.ctaHref}
  />
</Layout>
