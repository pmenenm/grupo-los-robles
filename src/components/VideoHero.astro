---
// src/components/VideoHero.astro
// Hero con video de fondo fijo (sticky) + panel glassmorphism que sube por encima al hacer
// scroll, revelando texto + CTA. Mismo truco de "fondo sticky + margen negativo" que ya usa
// ContactReveal.astro (bg pinneado con position:sticky mientras el foreground, más alto,
// scrollea encima) — no es un patrón nuevo en el proyecto, solo aplicado a un video.
const {
  videoSrc = 'videoHOME.mp4',
  poster = 'images/lujo-silencioso/division-gastronomia.jpg',
  text = 'Líderes en el sector gastronómico, nuestra meta principal es ofrecer siempre una experiencia única, con la mejor calidad y un servicio inmejorable.',
  ctaText = 'descubre mil sabores',
  ctaHref = 'https://grupomilsabores.cl/',
} = Astro.props;
---

<section class="vhero" data-gsap-section="video-hero">
  <div class="vhero__bg" aria-hidden="true">
    <video
      class="vhero__video"
      src={videoSrc}
      poster={poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
  </div>

  <div class="vhero__fg">
    <div class="vhero__spacer" aria-hidden="true"></div>

    <div class="vhero__panel" data-vhero-panel>
      <p class="vhero__text">{text}</p>
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="vhero__link"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initVideoHero() {
    const panel = document.querySelector<HTMLElement>('[data-vhero-panel]');
    const video = document.querySelector<HTMLVideoElement>('.vhero__video');
    if (!panel) return;

    if (video) {
      // ClientRouter re-inserta este <video> en el documento al navegar (ej. cambio de
      // idioma) sin disparar el algoritmo de carga de medios del navegador — el video
      // queda con networkState "sin fuente" y solo se ve el poster. Forzar load()
      // en cada astro:page-load lo repara sin afectar la carga inicial de la página.
      video.load();

      // Pausar el video fuera de viewport (mismo criterio que ShaderField.astro para
      // no gastar batería/CPU con motion invisible).
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }, { threshold: 0 });
      io.observe(video);
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.from(panel, {
      opacity: 0,
      y: 40,
      ease: 'none',
      scrollTrigger: {
        trigger: panel,
        start: 'top 95%',
        end: 'top 40%',
        scrub: 0.6,
      },
    });
  }

  document.addEventListener('astro:page-load', initVideoHero);
</script>

<style>
  .vhero {
    position: relative;
  }

  .vhero__bg {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    z-index: 0;
  }
  .vhero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vhero__fg {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }

  /* Deja el video visible, sin nada superpuesto, durante el primer tramo de scroll */
  .vhero__spacer {
    height: 100svh;
  }

  .vhero__panel {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-xl) var(--space-md);

    /* Glassmorphism: blur fuerte + fondo oscuro muy sutilmente transparente, para que el
       video se siga intuyendo detrás mientras el texto queda legible. */
    background-color: color-mix(in srgb, var(--bg-primary-inverse) 32%, transparent);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
  }

  .vhero__text {
    font-family: var(--font-heading);
    font-weight: 400;
    /* --text-quote, no --text-h2: este parrafo no es un heading (es la cita/manifiesto
       editorial larga, el mismo rol que ManifestoSection.astro), asi que le corresponde
       el token pensado exactamente para eso -- ver comentario de --text-quote en
       theme.css. Interlineado bien ajustado (1.15, pedido explicito) para que se lea
       compacto, no como un bloque de parrafo suelto. */
    font-size: var(--text-quote);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--text-primary-inverse) 95%, transparent);
    text-wrap: balance;
    max-width: 48rem;
    margin-inline: auto;
    text-shadow: 0 1px 20px rgba(0, 0, 0, 0.35);
  }

  /* Boton tipografico sutil: sin subrayado nativo, un borde inferior fino que se
     intensifica en hover -- reemplaza el glow/scale anterior, mas acorde a quiet luxury. */
  .vhero__link {
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: color-mix(in srgb, var(--text-primary-inverse) 95%, transparent);
    text-decoration: none;
    background: none;
    border: none;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary-inverse) 30%, transparent);
    padding: 0 0 var(--space-xs);
    margin-top: var(--space-lg);
    transition: border-color var(--transition-fast);
  }
  .vhero__link:hover,
  .vhero__link:focus-visible {
    border-color: var(--text-primary-inverse);
  }

  @media (min-width: 768px) {
    .vhero__link {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 600px) {
    /* backdrop-filter sobre un <video> en reproducción es costoso — se reduce en mobile
       para no comprometer el rendimiento (regla del proyecto: Lighthouse >= 90). */
    .vhero__panel {
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .vhero__text {
      font-size: 40px;
      max-width: 32ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vhero__bg { position: relative; height: auto; min-height: 60svh; }
    .vhero__fg { margin-top: 0; }
    .vhero__spacer { display: none; }
  }
</style>
