---
// src/components/LogoIntro.astro
// Selector de idioma flotante sobre el Hero (momento oscuro), visible antes del primer
// scroll. El wordmark grande que vivía acá se movió a Hero.astro (pedido explicito:
// "que quede cerca del titulo h1") -- este componente ahora solo resuelve el switch de
// idioma en esa franja superior; al primer scroll (mismo umbral que Header.astro, 40px)
// se desvanece y el Header compacto (logo chico + idioma + menu) toma su lugar.
const { locale = 'es' } = Astro.props;

const altHref = locale === 'en' ? '.' : 'en/';
const altLabel = locale === 'en' ? 'ES' : 'EN';
---

<div class="logo-intro" data-logo-intro>
  <a href={altHref} class="logo-intro__lang" aria-label={`${locale === 'en' ? 'Switch to Spanish' : 'Cambiar a inglés'}`}>{altLabel}</a>
</div>

<script>
  let cleanupLogoIntro: (() => void) | undefined;

  function initLogoIntro() {
    const el = document.querySelector<HTMLElement>('[data-logo-intro]');
    if (!el) return;

    const onScroll = () => el.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    cleanupLogoIntro = () => window.removeEventListener('scroll', onScroll);
  }

  document.addEventListener('astro:page-load', initLogoIntro);
  document.addEventListener('astro:before-swap', () => cleanupLogoIntro?.());
</script>

<style>
  .logo-intro {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-md);
    opacity: 1;
    transform: translateY(0);
    transition: opacity var(--transition-smooth), transform var(--transition-smooth);
  }

  /* Inverso de Header.astro: visible primero, se retira al hacer scroll */
  .logo-intro.is-scrolled {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
  }

  .logo-intro__lang {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: #f2ece0;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--transition-fast);
  }
  .logo-intro__lang:hover {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .logo-intro {
      padding-block: var(--space-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-intro {
      transition: none;
    }
  }
</style>
