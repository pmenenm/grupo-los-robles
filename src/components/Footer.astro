---
// src/components/Footer.astro
// Chrome global del sitio. Lee contracts/site*.json (marca + contacto + links) según `locale`.
// Fondo verde de marca (mismo --brand-green del Preloader) + texto café/marrón
// (--text-secondary-inverse, la misma variable "cálida sobre oscuro" que ya usan
// ManifestoSection/ContactReveal). El wordmark gigante ya NO usa mascara de imagen
// (background-clip:text) -- pedido explicito: "marca de agua monumental pero delicada",
// serif liviano a muy baja opacidad sobre el fondo, sin foto ni efecto detras.
import siteEs from '../../contracts/site.json';
import siteEn from '../../contracts/site.en.json';

const { locale = 'es' } = Astro.props;
const site = locale === 'en' ? siteEn : siteEs;

const t = locale === 'en'
  ? {
      talk: "Let's talk →", nav: 'Navigation', navLabel: 'Footer navigation', contact: 'Contact',
      write: 'Write to us →', rights: 'All rights reserved.',
    }
  : {
      talk: 'Hablemos →', nav: 'Navegación', navLabel: 'Navegación de pie de página', contact: 'Contacto',
      write: 'Escríbenos →', rights: 'Todos los derechos reservados.',
    };

const year = new Date().getFullYear();
const { siteName, tagline } = site.site;
const company = site.company ?? {};
const social = site.social ?? [];
const orderUrl = site.orderUrl ?? '#';
const hasContactInfo = company.email || company.phone || company.address;
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="images/LOGO-LOSrOBLES-BLANCO.webp" alt={siteName} />
      {tagline && <p class="site-footer__tagline">{tagline}</p>}
      <a href={orderUrl} class="site-footer__cta">{t.talk}</a>

      {social.length > 0 && (
        <ul class="site-footer__social" role="list">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} data-magnetic-link>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label={t.navLabel}>
        <h3>{t.nav}</h3>
        <ul role="list">
          {(site.navigation ?? []).map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__col">
        {hasContactInfo && <h3>{t.contact}</h3>}
        <ul role="list">
          {company.email   && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
          {company.phone   && <li><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a></li>}
          {company.address && <li><span>{company.address}</span></li>}
          {!hasContactInfo && <li><a href={orderUrl}>{t.write}</a></li>}
        </ul>
      </div>
    </div>
  </div>

  <p class="site-footer__giant" aria-hidden="true">{siteName.toUpperCase()}</p>

  <div class="container site-footer__bottom">
    <p>&copy; {year} {company.legalName ?? siteName}. {t.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    /* Momento de marca sobre fondo verde — mismo criterio de remapeo local de variables
       que ManifestoSection.astro, pero con --brand-green (Preloader) como fondo en vez
       del negro-inverse genérico del tema. */
    --bg-primary: var(--brand-green);
    --text-primary: var(--text-primary-inverse);
    --text-secondary: var(--text-secondary-inverse);
    --accent: var(--text-secondary-inverse);
    --accent-hover: var(--text-primary-inverse);
    --border: var(--border-inverse);

    position: relative;
    overflow: hidden;
    padding-top: var(--space-xl);
    background-color: var(--bg-primary);
    color-scheme: dark;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    /* "Rigor arquitectonico" (pedido explicito): borde inferior fino + mas aire antes
       de la marca de agua, en vez de sentirse flotando. */
    padding-bottom: var(--space-lg);
    /* Blanco (--text-primary-inverse), no --border-inverse: ese token esta calibrado
       para el negro casi puro de Manifesto/Contacto, no para el verde de marca de este
       footer -- ahi quedaba casi invisible. */
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary-inverse) 10%, transparent);
  }

  .site-footer__logo {
    height: 2rem;
    width: auto;
  }
  .site-footer__tagline {
    /* Serif editorial (pedido explicito), no la sans-serif de UI que tenia antes. */
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.625;
    color: color-mix(in srgb, var(--text-primary) 70%, transparent);
    margin-block: var(--space-sm);
    max-width: 24rem;
  }

  @media (min-width: 768px) {
    .site-footer__tagline { font-size: var(--text-xl); }
  }
  .site-footer__cta {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .site-footer__cta::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0.3);
    transform-origin: left;
    transition: transform var(--transition-fast);
  }
  .site-footer__cta:hover {
    color: var(--accent-hover);
    transform: translateX(3px);
  }
  .site-footer__cta:hover::after { transform: scaleX(1); }

  .site-footer__social {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin-top: var(--space-md);
  }
  .site-footer__social a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }
  .site-footer__social a:hover {
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  .site-footer__col h3 {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-primary) 40%, transparent);
    margin-bottom: var(--space-md);
  }
  .site-footer__col ul { list-style: none; display: grid; gap: 0; }
  .site-footer__col a,
  .site-footer__col span {
    display: block;
    width: fit-content;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--text-primary) 80%, transparent);
    text-decoration: none;
    margin-bottom: var(--space-xs);
    transition: color var(--transition-fast);
  }
  .site-footer__col a:hover { color: var(--text-primary); }

  /* EXCEPCIÓN deliberada a la escala tipográfica fija del proyecto (theme.css: --text-display/
     --text-h2/--text-h3, siempre en px, nunca clamp/vw): este wordmark es un billboard de
     una sola línea que debe caber de borde a borde del viewport a cualquier tamaño de
     pantalla, así que necesita escalar con vw por diseño -- no es un H1/H2/H3 real (es
     aria-hidden). Marca de agua serif monumental pero delicada (pedido explicito) --
     sin mascara de imagen, sin background-clip: solo tipografia a muy baja opacidad
     sobre el verde de marca, "textura, no letrero de neon". */
  .site-footer__giant {
    display: block;
    width: 100%;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-heading);
    font-weight: 300;
    text-transform: uppercase;
    line-height: 0.8;
    letter-spacing: -0.02em;
    text-align: center;
    font-size: 11vw;
    color: color-mix(in srgb, var(--text-primary-inverse) 10%, transparent);
    user-select: none;
  }

  @media (min-width: 768px) {
    .site-footer__giant {
      color: color-mix(in srgb, var(--text-primary-inverse) 15%, transparent);
    }
  }

  .site-footer__bottom {
    /* Ultra minimalista, justo debajo de la marca de agua (pedido explicito) -- sin
       borde, el espacio negativo ya la separa. */
    padding-block: var(--space-md) var(--space-sm);
    text-align: center;
  }
  .site-footer__bottom p {
    font-family: var(--font-body);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--text-primary) 30%, transparent);
  }

  @media (min-width: 768px) {
    .site-footer__top {
      /* Grilla de 12 columnas (pedido explicito): logo/bio en 1-4, nav+contacto
         arrancando en la 6 -- el hueco en la 5 es el aire intencional entre bloques. */
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
      column-gap: var(--space-lg);
      padding-bottom: var(--space-xl);
    }
    .site-footer__brand { grid-column: 1 / span 4; }
    .site-footer__cols {
      grid-column: 6 / span 7;
      grid-template-columns: 4fr 3fr;
      gap: var(--space-lg);
    }
  }
</style>
