       genericas), overflow:hidden recorta el mapa al mismo marco. */
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-inverse) 22%, transparent);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
