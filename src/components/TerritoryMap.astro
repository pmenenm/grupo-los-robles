    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    gap: var(--space-lg);
  }

  .territory__map-wrap {
    position: relative;
    min-width: 0;
    /* width:100% explicito (no confiar en el stretch por defecto de grid): sin esto se
       arma un ciclo de feedback real con el ResizeObserver del script -- el ancho del
       contenedor quedaba influenciado por el tamaño del <canvas> hijo que MapLibre
       redimensiona, el observer lo detectaba como "cambio de tamaño" y volvia a
       redimensionar, convergiendo hacia un contenedor colapsado de ~32px (el tamaño de
       un marcador). Con un ancho explicito el contenedor ya no depende de su contenido. */
    width: 100%;
    /* min-height (no height fijo): junto con el mismo min-height en .territory__panel
       y align-items:stretch en el grid, ambos modulos quedan siempre a la misma altura
       -- si el panel alguna vez necesita mas espacio que 70vh, la fila crece y el mapa
       la sigue, en vez de quedar mas bajo que el panel. */
    min-height: 70vh;
    /* Estetica hermana con el panel: mismo radio, borde y sombra para que ambos se
       sientan como modulos gemelos, no como elementos de peso visual distinto. El
