    width: 12px;
    height: 12px;
  }
  :global(.territory__marker--detail .territory__pin-dot) {
    width: 5.5px;
    height: 5.5px;
  }

  @keyframes territory-breathe {
    0%, 100% { transform: scale(0.85); opacity: 0.35; }
    50% { transform: scale(1.25); opacity: 0.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.territory__pin-glow) {
      animation: none;
      opacity: 0.5;
    }
  }

  .territory__panel {
    /* Columnas iguales ahora (ver .territory__grid): el panel ya no necesita un
       max-width angosto ni "justify-self:end" para no quedar perdido en una columna
       ancha -- "stretch" (el default de grid) llena su columna, del mismo ancho que la
       del mapa, para simetria real. "sticky" se mantiene como respaldo (ya no hace
       falta con el pin del bloque completo, pero no estorba). */
    position: sticky;
    top: var(--space-xl);
    min-height: 70vh;
    /* Fondo/borde suavizados a pedido del Ingeniero: la tarjeta debe sentirse como texto
       e imagen flotando sobre el fondo oscuro, no como un panel con borde duro y alto
       contraste. El backdrop-filter aporta la separacion visual en vez del borde. */
    background-color: color-mix(in srgb, var(--bg-secondary-inverse) 42%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid color-mix(in srgb, var(--border-inverse) 22%, transparent);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
    /* Mismo radio que el mapa (ver .territory__map-wrap) -- modulos gemelos. */
    border-radius: var(--radius-lg);
    /* Mas aire vertical (pedido explicito, "esta todo muy apretado"): la tarjeta ahora
       mide hasta 70vh (simetria con el mapa) pero el padding seguia siendo el de antes,
       pensado para una tarjeta mas baja -- el contenido quedaba apretado arriba con un
       vacio abajo. Mas padding vertical que horizontal para no angostar el ancho del
       texto ("Vitacura, Av. Nueva Costanera" necesita espacio para envolver bien). */
    padding: var(--space-xl) var(--space-lg);
    width: 100%;
    /* Flex column: el contenido (imagen/titulo/texto/hint) se apila de arriba hacia
