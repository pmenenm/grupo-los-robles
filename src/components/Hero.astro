---
// src/components/Hero.astro
// Hero "vitrina" — el hero funciona como galería: 3 fotografías editoriales en crossfade
// lento (referente: lingers.it, el hero ES la vitrina, no una sola imagen fija).
// Momento oscuro (texto claro sobre imagen) — usa las variables *-inverse del tema.
const {
  eyebrow = 'Grupo Los Robles',
  headline = 'Cinco industrias.<br/>Un mismo estándar<br/>de excelencia.',
  images = [],
  locale = 'es',
} = Astro.props;
---

<section id="inicio" class="hero" data-gsap-section="hero" aria-label="Grupo Los Robles">
  <div class="hero__vista" data-hero-vista aria-hidden="true">
    {images.map((img, i) => (
      <img
        class="hero__slide"
        class:list={[{ 'is-active': i === 0 }]}
        src={img.src}
        alt={img.alt ?? ''}
        loading={i === 0 ? 'eager' : 'lazy'}
        data-hero-slide
      />
    ))}
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="container hero__inner">
    <p class="hero__eyebrow" data-hero-eyebrow>{eyebrow}</p>
    <h1 class="hero__headline" data-hero-fade set:html={headline} />
  </div>

  <div class="hero__divider" aria-hidden="true"></div>

  <div class="hero__scrollcue" aria-hidden="true">
    <span></span>
  </div>

  {images.length > 1 && (
    <div class="hero__slider-controls">
      <button type="button" class="hero__slider-btn" data-hero-prev aria-label={locale === 'en' ? 'Previous photo' : 'Foto anterior'}>‹</button>
      <button type="button" class="hero__slider-btn" data-hero-next aria-label={locale === 'en' ? 'Next photo' : 'Foto siguiente'}>›</button>
    </div>
  )}
</section>

<script>
  import { gsap } from 'gsap';

  let rotateTimer;
  let cleanupHeroSlider;

  function initHeroVista() {
    const slides = document.querySelectorAll('[data-hero-slide]');
    if (slides.length < 2) return;
    clearInterval(rotateTimer);
    cleanupHeroSlider?.();

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = Math.max(0, [...slides].findIndex((s) => s.classList.contains('is-active')));

    function goTo(index) {
      const next = (index + slides.length) % slides.length;
      if (next === current) return;
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      current = next;
    }

    function startAuto() {
      if (reduced) return;
      clearInterval(rotateTimer);
      rotateTimer = setInterval(() => goTo(current + 1), 6500);
    }

    // Flechas manuales: pausan el auto-avance un ciclo entero (no lo cancelan del
    // todo, la galeria sigue "viva") antes de reanudarlo, para que un clic no quede
    // peleando con el timer si el usuario justo interactua cuando estaba por rotar.
    const prevBtn = document.querySelector('[data-hero-prev]');
    const nextBtn = document.querySelector('[data-hero-next]');
    const onPrev = () => { goTo(current - 1); startAuto(); };
    const onNext = () => { goTo(current + 1); startAuto(); };
    prevBtn?.addEventListener('click', onPrev);
    nextBtn?.addEventListener('click', onNext);
    cleanupHeroSlider = () => {
      prevBtn?.removeEventListener('click', onPrev);
      nextBtn?.removeEventListener('click', onNext);
    };

    startAuto();

    document.addEventListener('astro:before-swap', () => { clearInterval(rotateTimer); cleanupHeroSlider?.(); }, { once: true });
  }

  function initHeroEntrance() {
    const section = document.querySelector('[data-gsap-section="hero"]');
    const items = document.querySelectorAll('[data-hero-fade]');
    if (!section || !items.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.from(items, {
      y: 24,
      opacity: 0,
      duration: 1,
      ease: 'expo.out',
      stagger: 0.12,
      delay: 0.2,
    });
  }

  // Mientras LogoIntro.astro muestra el logo grande centrado (sin scroll), el eyebrow
  // compite visualmente con él — se oculta acá con el mismo umbral (40px) que usa
  // LogoIntro/Header, y vuelve a aparecer en cuanto ese logo se retira.
  let cleanupHeroEyebrow: (() => void) | undefined;

  function initHeroEyebrow() {
    const eyebrow = document.querySelector<HTMLElement>('[data-hero-eyebrow]');
    if (!eyebrow) return;

    const onScroll = () => eyebrow.classList.toggle('is-hidden-by-logo', window.scrollY <= 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    cleanupHeroEyebrow = () => window.removeEventListener('scroll', onScroll);
  }

  document.addEventListener('astro:page-load', () => {
    initHeroVista();
    initHeroEntrance();
    initHeroEyebrow();
  });
  document.addEventListener('astro:before-swap', () => cleanupHeroEyebrow?.());
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color-scheme: dark;
  }

  .hero__vista {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--bg-primary-inverse);
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.6s ease, transform 9s linear;
  }
  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    /* Reforzado: el texto vive en la mitad inferior y debe leerse bien sobre
       cualquiera de las 3 fotos del carrusel, sin importar cuán clara sea. */
    background:
      linear-gradient(0deg,
        color-mix(in srgb, var(--bg-primary-inverse) 92%, transparent) 0%,
        color-mix(in srgb, var(--bg-primary-inverse) 55%, transparent) 45%,
        transparent 78%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-primary-inverse) 35%, transparent) 0%, transparent 35%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    /* 10px base, sube a --text-xs (12px) desde 768px -- mas delicado para contrastar
       con el serif gigante del titulo (pedido explicito). */
    font-size: 10px;
    /* Tracking extremo (0.3em, el doble que antes): "vital para la elegancia". */
    letter-spacing: 0.3em;
    text-transform: uppercase;
    /* 80% -- via color-mix sobre el token del tema, nunca un rgba(255,255,255,...)
       hardcodeado. */
    color: color-mix(in srgb, var(--text-primary-inverse) 80%, transparent);
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
    opacity: 1;
    transition: opacity var(--transition-smooth);
  }

  @media (min-width: 768px) {
    .hero__eyebrow { font-size: var(--text-xs); }
  }
  .hero__eyebrow.is-hidden-by-logo {
    opacity: 0;
  }

  .hero__headline {
    font-family: var(--font-heading);
    text-transform: uppercase;
    /* Tamaño "poster de cine" por breakpoints con valores FIJOS (34/50/67px mas abajo,
       -30% sobre los 48/72/96px originales -- pedido explicito), nunca clamp()/vw -- la
       escala tipografica de H1/H2/H3 en este proyecto es siempre fija, nunca fluida
       (regla del Ingeniero). No se toca el token compartido --text-display (tambien lo
       usa CTA.astro) para no afectar esa otra seccion de paso. */
    font-size: 34px;
    /* Mas liviano (pedido explicito, "nunca bold/semi-bold en este estilo") -- 400, no
       500. Sigue siendo un peso real cargado via Google Fonts (ver pages/index.astro),
       nunca font-weight:700+ (regla dura del proyecto, maximo 600 en todo el sitio). */
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary-inverse);
    text-wrap: balance;
    /* Ancho tipo "poster" (~max-w-4xl) para que el titulo rompa en las 2 lineas ya
       fijadas por el <br/> del copy de forma equilibrada, centrado con margin-inline:
       auto (text-align:center del padre solo centra contenido inline, no el propio
       bloque del h1). */
    /* 1200px, no 900 (~max-w-4xl): a 96px de fuente, "UN MISMO ESTÁNDAR" solo no entraba
       en una linea a 900px y se partia en 4 lineas en vez de las 3 pedidas -- ajustado
       viendo el render real, no solo calculado. */
    max-width: 1200px;
    margin-inline: auto;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .hero__headline { font-size: 50px; }
  }
  @media (min-width: 1024px) {
    .hero__headline { font-size: 67px; }
  }

  .hero__scrollcue {
    position: absolute;
    left: 50%;
    bottom: var(--space-xs);
    z-index: 1;
    transform: translateX(-50%);
    width: 1px;
    height: 48px;
    background-color: color-mix(in srgb, var(--text-primary-inverse) 30%, transparent);
    overflow: hidden;
  }
  .hero__scrollcue span {
    display: block;
    width: 100%;
    height: 40%;
    background-color: var(--text-primary-inverse);
    animation: hero-scrollcue 2.2s ease-in-out infinite;
  }
  @keyframes hero-scrollcue {
    0%   { transform: translateY(-100%); }
    100% { transform: translateY(250%); }
  }

  .hero__divider {
    position: absolute;
    left: 0;
    right: 0;
    /* Ya no tiene que esquivar el H1 (ahora centrado, lejos del borde inferior) --
       vuelve a ser un simple acento de borde. */
    bottom: 32px;
    z-index: 1;
    width: 100%;
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary-inverse) 20%, transparent);
    pointer-events: none;
  }

  .hero__slider-controls {
    position: absolute;
    z-index: 1;
    /* El H1 ya no esta cerca del borde inferior (ahora centrado en la pantalla) --
       los controles vuelven a vivir en su propia esquina, independientes del texto.
       20% mas arriba que el token base (pedido explicito). */
    bottom: calc(var(--space-md) * 1.2);
    right: var(--space-md);
    display: flex;
    gap: var(--space-xs);
  }

  .hero__slider-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--text-primary-inverse) 40%, transparent);
    border-radius: var(--radius-sm);
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-lg);
    line-height: 1;
    color: color-mix(in srgb, var(--text-primary-inverse) 80%, transparent);
    cursor: pointer;
    transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }
  .hero__slider-btn:hover,
  .hero__slider-btn:focus-visible {
    border-color: var(--text-primary-inverse);
    color: var(--text-primary-inverse);
    background-color: color-mix(in srgb, var(--text-primary-inverse) 10%, transparent);
  }

  @media (max-width: 640px) {
    .hero__scrollcue { display: none; }
    .hero__divider { bottom: 32px; }
    .hero__slider-controls { bottom: calc(var(--space-sm) * 1.2); right: var(--space-sm); }

    /* Espacio para LogoIntro.astro: en mobile el contenido del Hero (centrado
       verticalmente) puede desbordar y su eyebrow queda pegado bajo el logo fijo de
       arriba — este padding le da el despeje exacto que ocupa esa barra. */
    .hero__inner { padding-top: 6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide { transition: opacity 0.3s linear; transform: none; }
  }
</style>
