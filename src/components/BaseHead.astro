---
// src/components/BaseHead.astro
import '../styles/theme.css';
import '../styles/tailwind.css';

const {
  title,
  description,
  image = '/images/default-og.jpg',
  canonicalUrl = Astro.url.href,
  googleFontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap',
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- Desactiva la restauración de scroll del navegador: sin esto, F5/recargar deja al
     usuario en la misma posición donde estaba antes de refrescar. history.scrollRestoration
     = 'manual' NO alcanza solo: en Chrome, al recargar, el motor reimpone la posición de
     scroll durante el parseo del HTML (después de que este script corre, pero antes de
     DOMContentLoaded) — por eso se refuerza el reset en varios puntos del ciclo de carga.
     Si la URL trae un ancla (ej. /#contacto) se respeta — no se fuerza el top ahí. -->
<script is:inline>
  (function () {
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    if (window.location.hash) return;

    var toTop = function () {
      if (!window.location.hash) window.scrollTo(0, 0);
    };
    toTop();
    document.addEventListener('DOMContentLoaded', toTop);
    window.addEventListener('load', toTop);
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) toTop();
    });
    // Chrome puede reimponer el scroll incluso después de DOMContentLoaded/load en
    // páginas con contenido pesado (imágenes/fuentes cargando) — un par de reintentos
    // cortos cubren ese margen sin quedar reintentando indefinidamente.
    setTimeout(toTop, 0);
    setTimeout(toTop, 100);
    setTimeout(toTop, 300);
  })();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- SEO básico -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type"        content="website" />
<meta property="og:url"         content={canonicalUrl} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={new URL(image, Astro.url)} />

<!-- Twitter Cards -->
<meta property="twitter:card"        content="summary_large_image" />
<meta property="twitter:url"         content={canonicalUrl} />
<meta property="twitter:title"       content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image"       content={new URL(image, Astro.url)} />

<!-- Google Fonts — URL inyectada por el Agente UI -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={googleFontsUrl} rel="stylesheet" />
