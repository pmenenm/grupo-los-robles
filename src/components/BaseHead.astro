---
// src/components/BaseHead.astro
import '../styles/theme.css';
import '../styles/tailwind.css';

const {
  title,
  description,
  image = 'images/default-og.jpg',
  canonicalUrl = Astro.url.href,
  googleFontsUrl = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap',
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- Todas las referencias internas (imagenes, favicon, nav entre es/en) son
     relativas (sin "/" inicial) para poder servir el sitio bajo un subpath (preview de
     GitHub Pages en pmenenm.github.io/grupo-los-robles/) sin tocar cada ruta a mano --
     el <base> nativo del navegador resuelve todo eso en runtime segun BASE_URL (que en
     produccion real, con "base" sin configurar, es simplemente "/"). DEBE ir antes que
     cualquier <link>/<img> que dependa de resolucion relativa. -->
<base href={import.meta.env.BASE_URL} />

<!-- Desactiva la restauración de scroll del navegador: sin esto, F5/recargar deja al
     usuario en la misma posición donde estaba antes de refrescar. history.scrollRestoration
     = 'manual' NO alcanza solo: en Chrome, al recargar, el motor reimpone la posición de
     scroll durante el parseo del HTML (después de que este script corre, pero antes de
     DOMContentLoaded) — por eso se refuerza el reset en varios puntos del ciclo de carga.
     Pedido explícito del Ingeniero: al refrescar (F5) SIEMPRE vuelve al tope, incluso si
     la URL trae un ancla (ej. /#contacto) -- se detecta el reload con la Navigation Timing
     API y se limpia el hash con replaceState para que el navegador no vuelva a saltar ahí
     por su cuenta. Un link entrante con ancla (no un refresh) sigue respetándose. -->
<script is:inline>
  (function () {
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    var navEntry = (performance.getEntriesByType && performance.getEntriesByType('navigation')[0]) || null;
    var isReload = navEntry ? navEntry.type === 'reload' : false;

    if (window.location.hash && !isReload) return;

    if (isReload && window.location.hash) {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }

    var toTop = function () {
      window.scrollTo(0, 0);
    };
    toTop();
    document.addEventListener('DOMContentLoaded', toTop);
    window.addEventListener('load', toTop);
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) toTop();
    });
    // Chrome puede reimponer el scroll incluso después de DOMContentLoaded/load en
    // páginas con contenido pesado (imágenes/fuentes cargando) — un par de reintentos
    // cortos cubren ese margen sin quedar reintentando indefinidamente.
    setTimeout(toTop, 0);
    setTimeout(toTop, 100);
    setTimeout(toTop, 300);
  })();
</script>
<link rel="icon" type="image/svg+xml" href="favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- SEO básico -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type"        content="website" />
<meta property="og:url"         content={canonicalUrl} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={new URL(image, Astro.url)} />

<!-- Twitter Cards -->
<meta property="twitter:card"        content="summary_large_image" />
<meta property="twitter:url"         content={canonicalUrl} />
<meta property="twitter:title"       content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image"       content={new URL(image, Astro.url)} />

<!-- Google Fonts — URL inyectada por el Agente UI -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href={googleFontsUrl} rel="stylesheet" />
