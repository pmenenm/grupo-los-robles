---
// src/components/Gallery.astro
// AGENTE FRONTEND: pasa title, subtitle (opcional) e items[] desde el contrato JSON
// AGENTE MOTION: clip-path reveal por fila + fade-up del texto, ScrollTrigger por item
// Formato editorial: imagen a sangre alternando de lado, label "0N —" como elemento gráfico

interface Item {
  image: string;
  alt: string;
  label: string;
  caption: string;
}

interface Props {
  title: string;
  subtitle?: string;
  items: Item[];
}

const { title, subtitle, items = [] } = Astro.props;
---

<section class="gallery" data-gsap-section="gallery">
  <div class="container gallery__header">
    <h2 class="gallery__title">{title}</h2>
    {subtitle && <p class="gallery__subtitle">{subtitle}</p>}
  </div>

  <div class="gallery__rows">
    {items.map((item, i) => (
      <article class={`gallery__row ${i % 2 === 1 ? 'gallery__row--reverse' : ''}`} data-gsap-animate="gallery-row">
        <div class="gallery__media">
          <img
            class="gallery__img"
            src={item.image}
            alt={item.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
        <div class="container gallery__text">
          <span class="gallery__label" aria-hidden="true">{item.label}</span>
          <p class="gallery__caption">{item.caption}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('[data-gsap-section="gallery"]');
  if (section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rows = section.querySelectorAll('[data-gsap-animate="gallery-row"]');

    rows.forEach((row) => {
      const img = row.querySelector('.gallery__img');
      const label = row.querySelector('.gallery__label');
      const caption = row.querySelector('.gallery__caption');

      gsap.from(img, {
        clipPath: 'inset(100% 0% 0% 0%)',
        scale: 1.15,
        duration: 1.3,
        ease: 'power4.inOut',
        scrollTrigger: { trigger: row, start: 'top 78%' },
      });

      gsap.from([label, caption], {
        y: 24,
        opacity: 0,
        stagger: 0.1,
        duration: 0.9,
        ease: 'expo.out',
        scrollTrigger: { trigger: row, start: 'top 70%' },
      });
    });
  }
</script>

<style>
  .gallery {
    padding-block: var(--space-xl);
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  .gallery__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    max-width: 560px;
  }

  .gallery__title {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    line-height: 1.05;
    color: var(--text-primary);
    letter-spacing: -0.03em;
  }

  .gallery__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .gallery__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .gallery__row {
    display: flex;
    flex-direction: column;
  }

  .gallery__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
  }

  .gallery__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-block: var(--space-md);
  }

  .gallery__label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .gallery__caption {
    font-family: var(--font-body);
    font-size: var(--text-xl);
    color: var(--text-primary);
    line-height: 1.4;
    max-width: 34ch;
  }

  /* ── Desktop: full-bleed alternado, imagen mitad / texto mitad ── */
  @media (min-width: 900px) {
    .gallery__row {
      flex-direction: row;
      align-items: stretch;
      min-height: 32rem;
    }

    .gallery__row--reverse {
      flex-direction: row-reverse;
    }

    .gallery__media {
      width: 55%;
      aspect-ratio: auto;
    }

    .gallery__text {
      width: 45%;
      justify-content: center;
      padding-inline: var(--space-xl);
      padding-block: 0;
    }

    .gallery__row--reverse .gallery__text {
      align-items: flex-end;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__img { transform: none; }
  }
</style>
