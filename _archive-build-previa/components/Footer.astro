---
// src/components/Footer.astro
// Chrome global del sitio. Lee contracts/site.json (marca + contacto + links).
import site from '../../contracts/site.json';

const year = new Date().getFullYear();
const { siteName, tagline } = site.site;
const company = site.company ?? {};
const brands = site.footerLinks ?? [];
const social = site.social ?? [];
const orderUrl = site.orderUrl ?? '#';
const hasContactInfo = company.email || company.phone || company.address;
const marqueeBrands = [...brands, ...brands]; // duplicado para loop continuo
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="/images/logo-losRobles.webp" alt={siteName} />
      {tagline && <p class="site-footer__tagline">{tagline}</p>}
      <a href={orderUrl} class="site-footer__cta">Hablemos →</a>

      {social.length > 0 && (
        <ul class="site-footer__social" role="list">
          {social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} data-magnetic-link>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label="Navegación de pie de página">
        <h3>Navegación</h3>
        <ul role="list">
          {(site.navigation ?? []).map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__col">
        {hasContactInfo && <h3>Contacto</h3>}
        <ul role="list">
          {company.email   && <li><a href={`mailto:${company.email}`}>{company.email}</a></li>}
          {company.phone   && <li><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a></li>}
          {company.address && <li><span>{company.address}</span></li>}
          {!hasContactInfo && <li><a href={orderUrl}>Escríbenos →</a></li>}
        </ul>
      </div>
    </div>
  </div>

  {brands.length > 0 && (
    <div class="site-footer__marquee" aria-label="Nuestras marcas">
      <div class="site-footer__marquee-track" data-marquee-track>
        {marqueeBrands.map((b) => (
          <a href={b.href} target="_blank" rel="noopener noreferrer" class="site-footer__marquee-item">
            {b.label}
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="container site-footer__bottom">
    <p>&copy; {year} {company.legalName ?? siteName}. Todos los derechos reservados.</p>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';

  function initFooter() {
    const track = document.querySelector('[data-marquee-track]');
    if (!track) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.set(track, { xPercent: 0 });
    gsap.to(track, {
      xPercent: -50,
      ease: 'none',
      duration: 22,
      repeat: -1,
    });
  }

  document.addEventListener('astro:page-load', initFooter);
</script>

<style>
  .site-footer {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--border) 35%, transparent);
    background-color: var(--bg-secondary);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
  }

  .site-footer__logo {
    height: 2rem;
    width: auto;
  }
  .site-footer__tagline {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin-block: var(--space-sm);
    max-width: 36ch;
  }
  .site-footer__cta {
    position: relative;
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  .site-footer__cta::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0.3);
    transform-origin: left;
    transition: transform var(--transition-fast);
  }
  .site-footer__cta:hover {
    color: var(--accent-hover);
    transform: translateX(3px);
  }
  .site-footer__cta:hover::after { transform: scaleX(1); }

  .site-footer__social {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    margin-top: var(--space-md);
  }
  .site-footer__social a {
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }
  .site-footer__social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }

  .site-footer__marquee {
    overflow: hidden;
    border-block: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
    padding-block: var(--space-sm);
    margin-block: var(--space-lg);
  }
  .site-footer__marquee-track {
    display: flex;
    width: max-content;
    gap: var(--space-2xl);
  }
  .site-footer__marquee-item {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 2rem);
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .site-footer__marquee-item:hover { color: var(--accent); }

  .site-footer__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }
  .site-footer__col h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: var(--space-sm);
  }
  .site-footer__col ul { list-style: none; display: grid; gap: var(--space-xs); }
  .site-footer__col a,
  .site-footer__col span {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .site-footer__col a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background-color: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-fast);
  }
  .site-footer__col a:hover { color: var(--accent); }
  .site-footer__col a:hover::after { transform: scaleX(1); }

  .site-footer__bottom {
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, var(--border) 20%, transparent);
  }
  .site-footer__bottom p {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .site-footer__top {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
      gap: var(--space-2xl);
    }
    .site-footer__cols { gap: var(--space-lg); }
  }
</style>
